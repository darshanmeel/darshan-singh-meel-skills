    {
      "id": "P1",
      "title": "Every mart rebuilt from all history each night",
      "area": "cost",
      "sev": "High",
      "evidence": [
        "dbt_project.yml:14",
        "models/marts/fct_orders.sql:1"
      ],
      "detail": "`+materialized: table` on all marts: each run rescans years of rows while only yesterday's orders change.",
      "cost": "warehouse time grows with total history, not with daily volume"
    },
    {
      "id": "P2",
      "title": "One scheduler VM, no standby",
      "area": "spof",
      "sev": "High",
      "evidence": [
        "infra/airflow/vm.tf:8"
      ],
      "detail": "Scheduler, worker and metadata DB share one VM.",
      "cost": "VM down at 02:00 means no marts that day; recovery is manual"
    },
    {
      "id": "P3",
      "title": "Whole table loaded into memory",
      "area": "scaling",
      "sev": "Medium",
      "evidence": [
        "extract/pull_orders.py:22-30"
      ],
      "detail": "`pd.read_sql` with no date filter and no chunks.",
      "cost": "out of memory once `orders` outgrows the VM's 8 GB"
    },
    {
      "id": "P4",
      "title": "Revenue logic copied in 3 marts",
      "area": "tech_debt",
      "sev": "Medium",
      "evidence": [
        "models/marts/fct_orders.sql:12-20",
        "models/marts/fct_returns.sql:8-16",
        "models/marts/fct_refunds.sql:8-16"
      ],
      "detail": "Net revenue `CASE` copied; the review found the copies already differ on tax.",
      "cost": "each rule change needs 3 edits; a missed one gives different totals per dashboard"
    },
    {
      "id": "P5",
