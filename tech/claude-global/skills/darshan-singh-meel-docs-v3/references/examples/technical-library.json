    "type": "h3",
    "text": "Parse: file → records → JSON on stdout"
   },
   {
    "type": "ipo",
    "input": "`tabkit parse users.csv`",
    "steps": [
     {
      "do": "Pick the parser by file extension",
      "out": "`csv` parser for `.csv`",
      "where": "src/tabkit/registry.py:14",
      "why": "the extension decides, not the content: a JSON file named x.csv fails as CSV"
     },
     {
      "do": "Read and split the file",
      "out": "`list[dict]`, one per row",
      "where": "src/tabkit/parsers/csv.py:8"
     },
     {
      "do": "Print as JSON",
      "out": "stdout, exit 0",
      "where": "src/tabkit/cli.py:40"
     }
    ],
    "output": "JSON records on stdout, exit 0",
    "examples": [
     {
      "case": "typical",
      "title": "Two-row CSV",
      "expect": "One record per row, header as keys",
      "in": "name,age / Ada,36 / Alan,41",
      "at": [
       "`csv`",
       "2 records",
       "exit 0"
      ],
      "out": "[{\"name\": \"Ada\", \"age\": \"36\"}, {\"name\": \"Alan\", \"age\": \"41\"}]",
      "source": "tests/test_csv.py:8"
     },
     {
      "case": "failure",
      "title": "Unknown extension",
      "expect": "Exit 2, known formats listed",
      "in": [
       [
        "file",
        "users.xml"
       ]
      ],
      "at": [
       "`KeyError: 'xml'`",
       null,
       null
      ],
      "out": [
       [
        "exit",
        "2"
       ],
       [
        "stderr",
        "unknown format 'xml': csv, ini, json"
       ]
      ],
      "source": "tests/test_cli.py:30"
     }
    ]
   },
   {
    "type": "h3",
    "text": "Validate: file + schema → issues, exit 0/1"
   },
   {
    "type": "ipo",
    "input": "`tabkit validate users.csv --schema s.json`",
    "steps": [
     {
      "do": "Parse the file",
      "out": "`list[dict]` records",
      "where": "src/tabkit/registry.py:14"
     },
     {
      "do": "Check each record against the schema",
      "out": "`issues`: one per missing field",
      "where": "src/tabkit/validate.py:15"
     },
     {
      "do": "Print issues, set the exit code",
      "out": "exit 0 (none) or 1",
      "where": "src/tabkit/cli.py:52",
      "why": "CI scripts gate on the exit code, not on the printed text"
     }
    ],
    "output": "Issues on stdout, exit 0 or 1",
    "examples": [
     {
      "case": "typical",
      "title": "All fields present",
      "expect": "No issues, exit 0",
      "in": [
       [
        "record",
        "name=Ada, age=36"
       ]
      ],
      "at": [
       "1 record",
       "0 issues",
       "exit 0"
      ],
      "out": [
       [
        "exit",
        "0"
       ]
      ],
      "source": "tests/test_validate.py:10"
     },
     {
      "case": "rejected",
      "title": "Missing required field",
      "expect": "One issue per missing field, exit 1",
