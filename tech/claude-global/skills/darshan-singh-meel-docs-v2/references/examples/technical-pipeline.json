  "Main flows": [
   {
    "type": "h3",
    "text": "Load: order events → orders, newest version wins"
   },
   {
    "type": "ipo",
    "input": "`landing.order_events`: nested JSON events",
    "steps": [
     {
      "do": "Read rows newer than last run",
      "out": "rows with `event_time` after the last run",
      "where": "src/jobs/load_orders.py:30",
      "why": "a missed run is caught up next time, never skipped"
     },
     {
      "do": "Flatten payload, rename and cast",
      "out": "1 flat row per event",
      "where": "src/jobs/load_orders.py:38"
     },
     {
      "do": "Merge on `order_id` + `status`, newest wins",
      "out": "`clean.orders` row",
      "where": "src/jobs/load_orders.py:45-52",
      "why": "replayed events would otherwise double paid orders"
     }
    ],
    "output": "`clean.orders`: one row per order + status",
    "examples": [
     {
      "case": "typical",
      "title": "First event",
      "expect": "New order + status is inserted",
      "in": [
       [
        "order_id",
        "O-1001"
       ],
       [
        "status",
        "PAID"
       ],
       [
        "ts",
        "2026-03-02 09:14"
       ],
       [
        "amount",
        "\"49.90\""
       ]
      ],
      "at": [
       "1 new event",
       [
        [
         "event_time",
         "2026-03-02 09:14"
        ],
        [
         "amount",
         "49.90"
        ]
       ],
       "+1 row: O-1001 PAID"
      ],
      "out": "`clean.orders` +1 row",
      "source": "tests/test_load_orders.py:40-62"
     },
     {
      "case": "edge",
      "title": "Older event arrives late",
      "expect": "Older event never overwrites a newer one",
      "in": [
       [
        "order_id + status",
        "same as above"
       ],
       [
        "ts",
        "2026-03-01 08:00 (older)"
       ]
      ],
      "at": [
       "1 new event",
       "1 flat row",
       "0 rows changed: stored 09:14 is newer"
      ],
      "out": "Row unchanged",
      "source": "tests/test_load_orders.py:65-90"
     },
     {
      "case": "failure",
      "title": "Missing order_id",
      "expect": "Event without its key stops the task",
      "in": [
       [
        "order_id",
        "NULL"
       ]
      ],
      "at": [
       "1 new event",
       "1 flat row, no key",
       "MERGE fails: `order_id` NULL"
      ],
      "out": "Task fails; e-mail sent",
      "source": "derived from src/common/explode.py:44"
     }
    ]
   },
   {
    "type": "h3",
    "text": "Explode: orders → one row per order line"
   },
   {
    "type": "ipo",
    "input": "`clean.orders` with a `lines` array",
    "steps": [
     {
      "do": "Read the merged orders",
      "out": "`clean.orders` rows with `lines`",
      "where": "src/jobs/explode_lines.py:14",
      "why": "explode runs after the merge, so lines come from the newest order version"
     },
     {
      "do": "One row per array item",
      "out": "`clean.order_lines` rows",
      "where": "src/common/explode.py:20-58",
      "why": "line-level reports need one row per item"
     }
    ],
    "output": "`clean.order_lines`: one row per order line",
    "examples": [
     {
      "case": "typical",
      "title": "Order with 2 lines",
      "expect": "One row per order line",
      "in": "O-1001, lines 1 and 2",
      "at": [
