   {
    "type": "io",
    "label": "SQL",
    "lang": "sql",
    "input": "SELECT o.order_id, o.status, l.line_no, l.sku\nFROM export.sales.orders o\nJOIN export.sales.order_lines l\n  ON l.order_id = o.order_id\n AND l.status = o.status\nWHERE o.order_id = 'O-1001';",
