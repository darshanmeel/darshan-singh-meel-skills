  "nodes": [
    {"id": "apps", "label": "Product apps", "sub": "12 services", "kind": "client"},
    {"id": "gw", "label": "LLM gateway", "sub": "auth, quotas, PII filter", "kind": "gateway"},
    {"id": "cache", "label": "Semantic cache", "sub": "Redis, TTL 1 h", "kind": "cache"},
    {"id": "router", "label": "Route by task", "kind": "router"},
    {"id": "large", "label": "large-model API", "sub": "complex tasks", "kind": "model", "group": "hosted"},
    {"id": "small", "label": "small-model API", "sub": "classification", "kind": "model", "group": "hosted"},
    {"id": "local", "label": "open-weights 8B", "sub": "vLLM, 4 GPUs", "kind": "model", "group": "own"}
  ],
  "edges": [
    {"from": "apps", "to": "gw", "label": "POST /v1/complete"},
    {"from": "gw", "to": "cache", "label": "lookup"},
