          {"layer": "Jobs", "tech": "Celery", "version": "5.4.*", "pinned_in": "pyproject.toml"},
          {"layer": "Database", "tech": "PostgreSQL", "version": "16", "pinned_in": "infra/db/main.tf"},
          {"layer": "Queue", "tech": "Redis", "version": "7.2", "pinned_in": "docker-compose.yml"},
          {"layer": "Frontend", "tech": "React / Vite", "version": "18.3 / 5.4", "pinned_in": "web/package.json"},
          {"layer": "Container", "tech": "python:3.12-slim", "version": "3.12-slim", "pinned_in": "Dockerfile"},
          {"layer": "Infra", "tech": "Terraform / AWS provider", "version": ">= 1.9 / ~> 5.0", "pinned_in": "infra/versions.tf"},
