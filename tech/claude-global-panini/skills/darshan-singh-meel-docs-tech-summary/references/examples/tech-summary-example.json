    "Deploy and environments": {
      "lead": "One image for api and worker; a merge to main deploys staging, a `v*` tag deploys production after approval.",
      "blocks": [
        {"type": "envs", "rows": [
          {"env": "local", "runs_on": "docker compose (postgres, redis) + processes", "deploy": "see Run locally", "access": "localhost"},
          {"env": "staging", "runs_on": "ECS Fargate, 1 api + 1 worker task", "deploy": "automatic on merge to `main`", "access": "VPN + SSO role `tracker-staging-dev`"},
          {"env": "production", "runs_on": "ECS Fargate, 2 api + 2 worker tasks", "deploy": "tag `v*`, manual approval in CI", "access": "SSO role `tracker-prod-ops`, read-only by default"}
        ]},
        {"type": "bullets", "items": [
          "Pipeline: test → build image → push to ECR → `terraform apply` → ECS rolling update.",
          "Rollback: rerun the deploy job with the previous image tag.",
          "Healthy: `GET /healthz` returns 200 and the worker logs `beat: tick` every 10 min.",
          "Infra lives in `infra/`, one module per concern, one state per environment."
        ]}
      ]
    },
    "Security and access": {
      "lead": "Staff sign in with OIDC; three roles; no secret is stored in the repo.",
      "blocks": [
        {"type": "table", "head": ["Topic", "How it works", "Where"], "rows": [
          ["Roles", "`viewer`, `operator`, `admin` from the `groups` claim; checked per route", "`api/auth/deps.py`"],
          ["Secrets", "Secrets Manager names `tracker/<env>/db`, `tracker/<env>/carrier-keys`; values `<redacted>`", "`infra/secrets/`"],
          ["Personal data", "Recipient name and address encrypted at rest (RDS, S3 SSE)", "`infra/db/`, `infra/storage/`"],
          ["Label links", "Presigned S3 URLs, valid 15 min; the bucket is private", "`api/services/labels.py`"],
          ["Network", "api behind an ALB with TLS; worker has no inbound port", "`infra/network/`"]
        ]}
      ]
    },
    "Run locally": {
      "lead": "Docker for postgres and redis, the rest as local processes; about five minutes from clone to first shipment.",
      "blocks": [
        {"type": "commands", "rows": [
          {"cmd": "docker compose up -d postgres redis", "does": "start the two stores", "expect": "2 containers healthy"},
          {"cmd": "uv sync", "does": "install Python dependencies from `uv.lock`"},
          {"cmd": "uv run alembic upgrade head", "does": "create the schema", "expect": "Running upgrade -> 0012"},
          {"cmd": "uv run uvicorn api.main:app --reload", "does": "start the API on port 8000", "expect": "Uvicorn running on http://127.0.0.1:8000"},
          {"cmd": "uv run celery -A worker.app worker -B -l info", "does": "start worker and beat", "expect": "celery@host ready"},
          {"cmd": "npm --prefix web run dev", "does": "start the web app", "expect": "Local: http://localhost:5173/"},
          {"cmd": "uv run pytest", "does": "run the test suite", "expect": "all tests pass"}
        ]},
        {"type": "bullets", "items": ["Settings come from environment variables listed in `docs/config.md`; local values from the team vault."]}
      ]
    },
    "Top risks": {
      "lead": "Polling cost and the deploy migration race matter most; both have a known fix.",
      "blocks": [
        {"type": "risks", "rows": [
          {"risk": "Migrations run at every container start", "impact": "two tasks can migrate at once during a production deploy", "status": "Confirmed",
           "mitigation": "run migrations as a one-off ECS task before the rollout", "where": "api/entrypoint.sh:4"},
          {"risk": "Carrier rate limits as volume grows", "impact": "429s delay status by more than 10 min", "status": "Design risk",
           "mitigation": "move carriers that offer them to webhooks"},
          {"risk": "Duplicate carrier events", "impact": "a customer may get two delivery emails", "status": "Not verified",
           "mitigation": "unique key on carrier event id", "where": "worker/tasks/poll.py:63"},
          {"risk": "Single Redis node without persistence", "impact": "queued jobs lost on restart until the next beat tick", "status": "Design risk",
           "mitigation": "acceptable today: beat re-enqueues within 10 min"},
          {"risk": "Label PDFs kept without end", "impact": "storage cost grows every month", "status": "Owner to decide",
           "mitigation": "Owner to decide: retention period, then an S3 lifecycle rule"}
        ]}
      ]
    },
