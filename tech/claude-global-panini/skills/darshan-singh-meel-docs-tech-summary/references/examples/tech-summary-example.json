{
  "title": "parcel-tracker: tech summary",
  "date": "2026-11-12",
  "subtitle": "Python 3.12 · FastAPI and Celery on AWS ECS · staff orders and carrier events → labels, parcel status, emails",
  "commit": "a1b2c3d",
  "graph": "knowledge graph at a1b2c3d",
  "sections": {
    "At a glance": {
      "lead": "One API, one worker and one database: staff create shipments in the web app, the worker keeps parcel status current from the carriers.",
      "blocks": [
        {"type": "facts", "rows": [
          ["What", "Creates shipments, prints labels and tracks parcels across carriers"],
          ["Stack", "Python 3.12 · FastAPI · Celery · PostgreSQL 16 · Redis 7 · React 18"],
          ["Runs on", "AWS ECS Fargate in `eu-central-1`; staging and production"],
          ["Schedule", "API on demand; carrier poll every 10 min"],
          ["In → out", "staff orders, carrier events → label PDFs, parcel status, customer emails"],
          ["Owner", "Logistics platform team"]
        ]},
        {"type": "scope",
         "does": ["Creates shipments and A6 label PDFs", "Tracks parcel status from carrier APIs", "Emails customers on delivery or exception"],
         "doesnt": ["Manage orders: the shop system owns them", "Handle returns or refunds", "Bill carriers"],
         "limits": ["Status lags the carrier by up to 10 min", "Up to 20 parcels per shipment", "Labels in one format: A6 PDF"]},
        {"type": "rules", "rows": [
          {"rule": "A shipment cannot change once its label exists; staff cancel and recreate it.", "where": "api/services/shipments.py:77"},
          {"rule": "A parcel status only moves forward; an older carrier event never overwrites a newer one.", "where": "worker/tasks/poll.py:58"}
        ]}
      ]
    },
    "Components": {
      "lead": "Six runtime parts; the API and the worker share one PostgreSQL database and talk through a Redis queue.",
      "blocks": [
        {"type": "flow", "title": "Runtime components", "key": "Grey fill = data store · dashed border = external system · pill = person",
         "nodes": [
           {"id": "staff", "label": "Shop staff", "kind": "actor", "col": 0, "row": 0},
           {"id": "web", "label": "web", "sub": "React SPA", "col": 1, "row": 0},
           {"id": "api", "label": "api", "sub": "FastAPI", "kind": "entry", "col": 2, "row": 0},
           {"id": "redis", "label": "redis", "sub": "Celery broker", "kind": "store", "col": 3, "row": 0},
           {"id": "labels", "label": "labels bucket", "sub": "S3", "kind": "store", "col": 1, "row": 1},
           {"id": "pg", "label": "postgres", "sub": "RDS PostgreSQL 16", "kind": "store", "col": 2, "row": 1},
           {"id": "worker", "label": "worker", "sub": "Celery worker + beat", "kind": "job", "col": 3, "row": 1},
           {"id": "email", "label": "Email service", "sub": "SMTP relay", "kind": "external", "col": 2, "row": 2},
           {"id": "carrier", "label": "Carrier tracking APIs", "kind": "external", "col": 3, "row": 2}
         ],
         "edges": [
           {"from": "staff", "to": "web", "label": "browser"},
           {"from": "web", "to": "api", "label": "REST /v1"},
           {"from": "api", "to": "redis", "label": "enqueue"},
           {"from": "api", "to": "labels", "label": "PDF"},
           {"from": "api", "to": "pg", "label": "SQL"},
           {"from": "redis", "to": "worker", "label": "jobs"},
           {"from": "worker", "to": "pg", "label": "events"},
           {"from": "worker", "to": "email", "label": "notify"},
           {"from": "worker", "to": "carrier", "label": "poll"}
         ]},
        {"type": "components", "rows": [
          {"name": "web", "does": "Shipment forms, label download, parcel timeline", "tech": "React 18, Vite", "where": "web/src/"},
          {"name": "api", "does": "REST API, sign-in, label rendering; the only writer of shipments", "tech": "FastAPI, SQLAlchemy 2", "where": "api/"},
          {"name": "worker", "does": "Polls carriers, stores tracking events, sends emails", "tech": "Celery 5 with beat", "where": "worker/"},
          {"name": "postgres", "does": "Shipments, parcels, tracking events, users", "tech": "PostgreSQL 16 on RDS", "where": "api/db/"},
          {"name": "redis", "does": "Job queue between api and worker; no business data", "tech": "Redis 7 on ElastiCache", "where": "worker/app.py"},
          {"name": "labels bucket", "does": "Label PDFs, read through presigned URLs", "tech": "S3, SSE-S3", "where": "infra/storage/"}
        ]}
      ]
    },
    "Main flows": {
      "lead": "Three flows cover what a new engineer meets first: creating a shipment, tracking it, and signing in.",
      "blocks": [
        {"type": "seq", "title": "Create a shipment and its label",
         "why": "The label must exist before staff leave the form: the carrier pickup scan needs it.",
         "participants": [
           {"id": "web", "label": "web"}, {"id": "api", "label": "api"},
           {"id": "pg", "label": "postgres", "kind": "store"}, {"id": "labels", "label": "labels bucket", "kind": "store"}],
         "steps": [
           {"from": "web", "to": "api", "do": "POST /v1/shipments", "out": "validated order and address", "where": "api/routes/shipments.py:28",
            "alt": "422 with the failing fields"},
           {"from": "api", "to": "pg", "do": "insert shipment, status CREATED", "out": "`shipments` row and its parcels", "where": "api/services/shipments.py:41"},
           {"from": "api", "to": "labels", "do": "render and store label PDF", "out": "`labels/SHP-1042.pdf`", "where": "api/services/labels.py:17"},
           {"from": "api", "to": "web", "do": "return shipment and label URL", "out": "201, presigned URL valid 15 min", "back": true}
         ],
         "example": {"in": "POST /v1/shipments\n{\"carrier\": \"CX\", \"parcels\": [{\"weight_g\": 1200}],\n \"to\": {\"postcode\": \"10115\", \"country\": \"DE\"}}",
                     "out": "201 Created\n{\"id\": \"SHP-1042\", \"status\": \"CREATED\",\n \"label_url\": \"https://<bucket>/labels/SHP-1042.pdf?X-Amz-Expires=900\"}",
                     "source": "from tests/api/test_shipments.py::test_create_shipment (synthetic values)"}},
        {"type": "seq", "title": "Track parcel status",
         "why": "We poll every 10 minutes because two of the three carriers offer no webhooks.",
         "participants": [
           {"id": "redis", "label": "redis", "kind": "store"}, {"id": "worker", "label": "worker", "kind": "job"},
           {"id": "carrier", "label": "Carrier tracking APIs", "kind": "external"}, {"id": "pg", "label": "postgres", "kind": "store"},
           {"id": "email", "label": "Email service", "kind": "external"}],
         "steps": [
           {"from": "worker", "to": "redis", "do": "beat enqueues poll_active every 10 min", "out": "one job per carrier", "where": "worker/schedules.py:9"},
           {"from": "redis", "to": "worker", "do": "deliver poll job", "out": "carrier code and cursor", "back": true},
           {"from": "worker", "to": "carrier", "do": "fetch events since cursor", "out": "new tracking events", "where": "worker/carriers/client.py:34",
            "alt": "429 → retry with backoff, at most 5 times"},
           {"from": "worker", "to": "pg", "do": "upsert events, update parcel status", "out": "`tracking_events` rows, new `parcels.status`", "where": "worker/tasks/poll.py:52"},
           {"from": "worker", "to": "email", "do": "notify on DELIVERED or EXCEPTION", "out": "one email per status change", "where": "worker/tasks/notify.py:21"}
         ],
         "example": {"in": "carrier event\n{\"tracking_no\": \"CX123456789\", \"code\": \"DLV\",\n \"at\": \"2026-03-02T14:05:00Z\"}",
                     "out": "tracking_events: (parcel_id 77, DELIVERED, 2026-03-02 14:05)\nparcels.status: IN_TRANSIT → DELIVERED\nemail: delivered template",
                     "source": "from tests/worker/test_poll.py::test_delivered_event (synthetic values)"}},
        {"type": "seq", "title": "Staff sign-in",
         "why": "Roles come from identity-provider groups, so access is granted in one place.",
         "participants": [
           {"id": "staff", "label": "Shop staff", "kind": "actor"}, {"id": "web", "label": "web"},
           {"id": "api", "label": "api"}, {"id": "idp", "label": "Identity provider", "kind": "external"}],
         "steps": [
           {"from": "staff", "to": "web", "do": "open the app", "out": "redirect to sign-in (OIDC code flow)"},
           {"from": "web", "to": "api", "do": "GET /v1/auth/callback with code", "out": "authorization code and state", "where": "api/auth/routes.py:15"},
           {"from": "api", "to": "idp", "do": "exchange code for tokens", "out": "ID token, 1 h", "where": "api/auth/oidc.py:40",
            "alt": "401 when state or nonce do not match"},
           {"from": "api", "to": "web", "do": "set session cookie", "out": "HttpOnly cookie, role from `groups` claim", "back": true}
         ]}
      ]
    },
    "Data model": {
      "lead": "Five tables; a shipment has parcels, a parcel has tracking events. Alembic owns the schema.",
      "blocks": [
        {"type": "er", "title": "Core tables (schema `tracker`)", "key": "Solid = foreign key · dashed = logical link, not enforced · 1:N = one to many",
         "entities": [
           {"id": "users", "name": "users", "keys": ["PK id", "UK email_hash", "role"]},
           {"id": "shipments", "name": "shipments", "keys": ["PK id", "FK created_by", "FK carrier_code", "status"], "more": 9},
           {"id": "parcels", "name": "parcels", "keys": ["PK id", "FK shipment_id", "UK tracking_no", "status"], "more": 4},
           {"id": "events", "name": "tracking_events", "keys": ["PK id", "FK parcel_id", "occurred_at"], "more": 3},
           {"id": "carriers", "name": "carriers", "keys": ["PK code", "poll_cursor"], "more": 2}
         ],
         "rels": [
           {"a": "users", "b": "shipments", "card": "1:N", "on": "created_by"},
           {"a": "shipments", "b": "parcels", "card": "1:N", "on": "shipment_id"},
           {"a": "parcels", "b": "events", "card": "1:N", "on": "parcel_id"},
           {"a": "carriers", "b": "shipments", "card": "1:N", "on": "carrier_code", "logical": true}
         ]},
        {"type": "bullets", "items": [
          "`tracking_events` is append-only; `parcels.status` holds the latest status.",
          "Recipient name and address live in `shipments`; they are personal data.",
          "Migrations: `api/db/migrations/` (Alembic)."
        ]}
      ]
    },
    "Integrations": {
      "lead": "Four external systems; carrier keys and SMTP credentials are per environment in Secrets Manager.",
      "blocks": [
        {"type": "integrations", "rows": [
          {"system": "Carrier tracking APIs", "direction": "out", "via": "HTTPS REST, polled", "data": "tracking events per parcel", "auth": "API key per carrier"},
          {"system": "Email service", "direction": "out", "via": "SMTP over TLS", "data": "delivery and exception emails", "auth": "SMTP user `tracker-mailer`"},
          {"system": "Identity provider", "direction": "both", "via": "OIDC code flow", "data": "staff identity, `groups` claim", "auth": "client `parcel-tracker`"},
          {"system": "Shop system", "direction": "in", "via": "CSV upload in web", "data": "orders to ship", "auth": "staff session"}
        ]}
      ]
    },
