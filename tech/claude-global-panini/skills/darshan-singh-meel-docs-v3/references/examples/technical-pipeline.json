     [
      "Empty child list keeps parent",
      "see step 4.2.2",
      "an order without lines still counts in order totals",
      ""
     ],
     [
      "Amount cast to decimal, no rounding",
      "see step 4.1.2",
      "finance totals must match the source to the cent",
      ""
