  "Business rules": [
   {
    "type": "rules",
    "rows": [
     [
      "Newest event wins, also inside one batch",
      "O-1001 PAID 09:14 + 10:00 → 1 row, from 10:00",
      "two versions in one batch would both survive a plain insert",
      "`src/jobs/load_orders.py:44`"
