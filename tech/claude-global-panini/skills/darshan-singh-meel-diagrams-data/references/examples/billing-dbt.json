      "label": "billing.invoices",
      "resource_type": "source",
      "layer": "sources"
    },
    {
      "id": "plan_prices",
      "resource_type": "seed",
      "layer": "sources"
    },
    {
      "id": "stg_accounts",
      "resource_type": "model",
      "materialized": "view",
      "tests": 3,
      "layer": "staging",
      "depends_on": [
        "src_accounts"
      ]
    },
    {
      "id": "stg_invoices",
      "resource_type": "model",
      "materialized": "view",
      "tests": 4,
      "layer": "staging",
      "depends_on": [
        "src_invoices"
      ]
    },
    {
      "id": "accounts_snap",
      "resource_type": "snapshot",
      "layer": "staging",
      "depends_on": [
        "src_accounts"
      ]
    },
    {
