    {
      "id": "fct_mrr",
      "resource_type": "model",
      "materialized": "incremental",
      "tests": 6,
      "layer": "marts",
      "depends_on": [
        "int_mrr_moves"
      ]
    },
    {
      "id": "mrr_board",
