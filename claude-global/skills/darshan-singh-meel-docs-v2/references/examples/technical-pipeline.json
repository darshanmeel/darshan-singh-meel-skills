{"type":"technical","app_types":["pipeline"],"title":"Orders pipeline","subtitle":"Spark on a job scheduler · daily · sources: knowledge graph, code, tests · all names and values illustrative",
"tabs":{"does":["Reads order events from the landing table once a day","Keeps the newest version of each order (`order_id` + `status`)","Splits orders into lines, discounts and shipments","Publishes 4 read-only views in `export.sales`","E-mails the team when a task fails"],
 "doesnt":["Doesn't receive events — a separate feed fills `landing.order_events`","Doesn't calculate totals — views copy tables one to one","Doesn't grant read access — platform team"],
 "limitations":["Daily at 05:00, not real-time","Each task stops after 1 hour","No automatic retry"],
 "top_issues":[{"text":"Two shipments with the same `shipment_no` — one is lost","status":"Confirmed (test)"},{"text":"Lines removed in a later event may stay","status":"Not verified"},{"text":"Library version differs between tests and production","status":"Confirmed (review)"},{"text":"No retry on a short platform glitch","status":"Confirmed (review)"},{"text":"`deleted_at` filled in 2 of 4 views only","status":"Not verified"}]},
