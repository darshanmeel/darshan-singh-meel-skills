 "title": "Tasks app",
 "subtitle": "React + FastAPI + Postgres · on request · browser → tasks table",
 "tabs": {
  "does": [
   "Signs users in with e-mail and password (JWT in an http-only cookie)",
   "Lists, adds, changes and deletes tasks per project",
   "Shows a dashboard with open and done counts"
  ],
  "doesnt": [
   "Doesn't send e-mails or reminders",
   "Doesn't share projects between users"
  ],
  "limitations": [
   "One user per project",
   "No offline mode"
  ],
  "top_issues": [
   {
    "text": "Any signed-in user can delete another user's task by id",
    "status": "Confirmed (test)"
   },
   {
    "text": "Login has no rate limit",
    "status": "Confirmed (code)"
   }
  ]
 },
